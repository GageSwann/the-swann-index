# Copy to backend/.env and fill in values. backend/.env is gitignored.
# Names only here, never real values.

# CollegeFootballData.com API key (https://collegefootballdata.com/key)
CFBD_API_KEY=

# Neon Postgres connection string for the DEV branch (Neon console -> Connect)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Max CFBD calls per calendar month; ingest stops before exceeding it
CFBD_MONTHLY_CALL_BUDGET=1000

# Comma-separated origins allowed to call the API
TSI_CORS_ORIGINS=http://localhost:3000
