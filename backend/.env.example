# Copy to backend/.env and fill in values. backend/.env is gitignored.
# Names only here, never real values.

# CollegeFootballData.com API key (https://collegefootballdata.com/key).
# Needed for ingest (`tsi run`, `tsi ingest ...`); the API server runs without it.
CFBD_API_KEY=

# Neon Postgres connection string for the DEV branch (Neon console -> Connect)
# Format: postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
DATABASE_URL=

# Optional: DIRECT (non-pooled) string for migrations. Same as above but the host
# has no "-pooler" (Neon Connect -> turn off "Connection pooling"). Falls back to DATABASE_URL.
DATABASE_URL_DIRECT=

# Max CFBD calls per calendar month (free tier ~1,000; margin for calls made outside the client)
CFBD_MONTHLY_CALL_BUDGET=980

# Optional: where raw CFBD responses are cached (default: backend/.cache)
TSI_CACHE_DIR=

# Comma-separated origins allowed to call the API
TSI_CORS_ORIGINS=http://localhost:3000

# Optional: the owner's key for the private endpoints (/book/*, /model/report), sent as
# `Authorization: Bearer <key>`. Set the same value on Render. At least 32 random
# characters, e.g.: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Unset on the API = those endpoints answer 404 to everyone.
OWNER_API_KEY=
