# Copy to web/.env.local and fill in values. .env.local is gitignored.
# Never prefix a secret with NEXT_PUBLIC_ (that ships it to the browser).

# Base URL of the TSI FastAPI service
TSI_API_URL=http://localhost:8000

# Shared secret for /api/revalidate (server-only). Generate a long random string.
REVALIDATE_TOKEN=
